# === macOS ===
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore

.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
._*

# === VS Code ===
# https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.vsix


# === Kustomize Helm charts ===
# Downloaded by kustomize build --enable-helm
gitops/infrastructure/*/charts/
gitops/clusters/*/*/*/charts/

# Gitea checkouts used by scripts/sync-projects.sh. Never part of this repo.
.sync/

# === Kustomize secret env files ===
# Generated by run.sh with runtime credentials
gitops/clusters/*/*/*/secrets/*.env

# Kubeconfigs and port-forwards for the vclusters. Never part of this repo.
.idp/

# === Terraform ===
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform/clusters/*-config
